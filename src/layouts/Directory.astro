---
/**
 * A course directory page: the site shell, breadcrumbs, a heading and the
 * page's content, with its structured data. Every directory page carries
 * noindex until DIRECTORY_INDEXABLE is switched on (lib/directory/config).
 *
 * Each page also carries one hidden, nofollow link to /courses/export: a path
 * robots.txt disallows, so search engines never fetch it and only a scraper
 * ignoring robots.txt walks in (logged by src/pages/courses/export.ts, and
 * blocked at Cloudflare's firewall).
 */
import Base from "./Base.astro";
import { DIRECTORY_INDEXABLE } from "../lib/directory/config";
import { jsonLdString } from "../lib/directory/jsonLd";

interface Props {
  title: string;
  description: string;
  crumbs?: ReadonlyArray<{ label: string; href?: string }>;
  structured?: Record<string, unknown>;
  /** A wider measure, for the course page's two-column top. */
  wide?: boolean;
}
const { title, description, crumbs = [], structured, wide = false } = Astro.props;
---

<Base title={title} description={description} noindex={!DIRECTORY_INDEXABLE}>
  {structured && <script slot="head" type="application/ld+json" set:html={jsonLdString(structured)} />}
  <article class:list={["v-container directory", { wide }]}>
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <slot />
    <a class="trap" href="/courses/export" rel="nofollow" tabindex="-1" aria-hidden="true">Course data export</a>
  </article>
</Base>

<style>
  .directory {
    max-width: calc(880px + 2 * var(--page-gutter));
    padding-block: var(--s12) 0;
  }
  .directory.wide {
    max-width: calc(1120px + 2 * var(--page-gutter));
  }
  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    list-style: none;
    margin: 0 0 var(--s5);
    padding: 0;
    font-size: var(--t-ui-meta);
    color: var(--v-text-secondary);
  }
  .crumbs li + li::before {
    content: "›";
    margin-right: var(--s2);
    color: var(--v-text-tertiary);
  }
  .crumbs a {
    color: var(--v-text-secondary);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--v-text-primary);
  }
  .directory :global(.dx-title) {
    font-size: var(--t-h1);
    letter-spacing: -0.02em;
  }
  .directory :global(.dx-sub) {
    margin-top: var(--s2);
    color: var(--v-text-secondary);
  }
  .directory :global(.dx-sub a) {
    color: inherit;
  }
  .directory :global(.dx-lede) {
    margin-top: var(--s5);
    font-size: var(--t-ui-large);
    line-height: 1.6;
    max-width: 40rem;
  }
</style>
