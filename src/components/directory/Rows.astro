---
/**
 * A card of rows: links with a name, optional meta line, an optional value
 * on the right and a chevron. Used for courses, counties, lists and facts.
 */
export type Row = {
  href?: string;
  name: string;
  meta?: string | null;
  end?: string | number | null;
  endLabel?: string;
  position?: number;
  external?: boolean;
};
interface Props {
  rows: ReadonlyArray<Row>;
  columns?: 1 | 2;
  ordered?: boolean;
}
const { rows, columns = 1, ordered = false } = Astro.props;
const List = ordered ? "ol" : "ul";
---

<List class:list={["dx-rows", { two: columns === 2 }]}>
  {
    rows.map((r) => {
      const Tag = r.href ? "a" : "span";
      return (
        <li>
          <Tag class="row" href={r.href} rel={r.external ? "noopener" : undefined}>
            {r.position != null && <span class="pos v-tabular">{r.position}</span>}
            <span class="body">
              <span class="name">{r.name}</span>
              {r.meta && <span class="meta">{r.meta}</span>}
            </span>
            {r.end != null && (
              <span class="end v-tabular" aria-label={r.endLabel}>
                {r.end}
              </span>
            )}
            {r.href && <span class="chev" aria-hidden="true">{r.external ? "↗" : "›"}</span>}
          </Tag>
        </li>
      );
    })
  }
</List>

<style>
  .dx-rows {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: var(--s1) 0;
    background: var(--v-surface-raised);
    box-shadow: var(--card-edge);
    border-radius: var(--r-xl);
  }
  .dx-rows.two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s4);
  }
  li + li .row {
    border-top: 1px solid var(--v-separator);
  }
  .two li:nth-child(2) .row {
    border-top: 0;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 56px;
    margin: 0 var(--s5);
    padding: var(--s3) 0;
    color: var(--v-text-primary);
    text-decoration: none;
  }
  a.row:hover .name {
    color: var(--v-accent-ink);
  }
  .pos {
    flex: none;
    min-width: 2ch;
    color: var(--v-text-secondary);
    font-size: var(--t-ui-body);
  }
  .body {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }
  .name {
    font-weight: 600;
    font-size: var(--t-ui-body);
  }
  .meta {
    font-size: var(--t-ui-meta);
    color: var(--v-text-secondary);
  }
  .end {
    flex: none;
    font-size: var(--t-ui-body);
    color: var(--v-text-secondary);
  }
  .chev {
    flex: none;
    color: var(--v-text-tertiary);
  }
  @media (max-width: 600px) {
    .dx-rows.two {
      grid-template-columns: minmax(0, 1fr);
    }
    .two li:nth-child(2) .row {
      border-top: 1px solid var(--v-separator);
    }
    .row {
      margin: 0 var(--s4);
    }
  }
</style>
