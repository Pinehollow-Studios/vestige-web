---
/**
 * Signature scene two: the app, for real, as one pinned sheet (the Apple
 * product-page pattern; Tom, 3 Oct 2026).
 *
 * The scene takes one screen's worth of space and pins under the header
 * while you scroll through it. Scrolling moves through four steps: the
 * phone's bezel stays still and its screen pushes across to the next, the
 * words crossfade beside it (below it on phones), and the dots show where
 * you are (tap one to go there). Every step gets an even share of the
 * scroll.
 *
 * The script below does the pinning (it adds .is-pinned, which makes the
 * section tall and the sheet sticky) and maps scroll to step. Without
 * JavaScript the scene is a plain section: the first screen, and every step
 * listed beside it. With reduced motion it still pins, but changes are
 * instant.
 */
import { screens, type Screen } from "../../data/screens";
import PhoneFrame from "../PhoneFrame.astro";

const steps: ReadonlyArray<{ title: string; body: string; screen: Screen }> = [
  {
    title: "Your map, front and centre",
    body: "Open the app and there’s England, county by county, your played courses glowing. Search for any course, or wander the map and see what’s near.",
    screen: screens.homeMap,
  },
  {
    title: "Tap to mark it played",
    body: "Every course has its own page: the facts, its outline from above, where it ranks. One tap and it’s yours. Nobody’s checking your handicap.",
    screen: screens.courseHankleySatellite,
  },
  {
    title: "Lists to work through",
    body: "The Top 100, the Open venues, every course in your county. Each one ticks down as you go. It gets moreish.",
    screen: screens.listTop100,
  },
  {
    title: "A collection to be proud of",
    body: "Your profile keeps the lot: courses played, counties finished, your top three. The kind of thing you show people at the bar.",
    screen: screens.profile,
  },
];
---

<section class="walk" aria-labelledby="walk-title" data-walk style={`--steps: ${steps.length}`}>
  <div class="sheet">
    <div class="v-container grid">
      <div class="words">
        <div class="head">
          <p class="v-kicker">The app</p>
          <h2 id="walk-title" class="v-display">Collecting courses, made simple.</h2>
        </div>

        <ol class="steps">
          {
            steps.map((step, i) => (
              <li data-step={i} data-on={i === 0 ? "" : undefined}>
                <span class="num v-tabular">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="dots" role="group" aria-label="Steps">
          {
            steps.map((step, i) => (
              <button
                type="button"
                data-go={i}
                data-on={i === 0 ? "" : undefined}
                aria-label={`Step ${i + 1}: ${step.title}`}
              />
            ))
          }
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <PhoneFrame
          screen={steps[0].screen}
          more={steps.slice(1).map((step) => step.screen)}
          maxWidth={320}
          class="stage-phone"
        />
      </div>
    </div>
  </div>
</section>

<script>
  for (const walk of document.querySelectorAll<HTMLElement>("[data-walk]")) {
    const sheet = walk.querySelector<HTMLElement>(".sheet")!;
    const layers = walk.querySelectorAll<HTMLElement>("[data-layer]");
    const steps = walk.querySelectorAll<HTMLElement>("[data-step]");
    const dots = walk.querySelectorAll<HTMLButtonElement>("[data-go]");
    const count = steps.length;
    let current = -1;

    walk.classList.add("is-pinned");

    const show = (i: number) => {
      if (i === current) return;
      current = i;
      layers.forEach((layer) => {
        const n = Number(layer.dataset.layer);
        layer.dataset.state = n < i ? "before" : n === i ? "on" : "after";
      });
      steps.forEach((step, n) => step.toggleAttribute("data-on", n === i));
      dots.forEach((dot, n) => {
        dot.toggleAttribute("data-on", n === i);
        dot.setAttribute("aria-current", n === i ? "step" : "false");
      });
    };

    // How far through the pinned stretch we are, 0 to 1: the sheet sticks
    // `stick` px from the top (under the header) for walk height minus
    // sheet height of scrolling.
    const stick = () => parseFloat(getComputedStyle(sheet).top) || 0;
    const progress = () => {
      const travel = walk.offsetHeight - sheet.offsetHeight;
      const moved = stick() - walk.getBoundingClientRect().top;
      return travel > 0 ? Math.min(1, Math.max(0, moved / travel)) : 0;
    };

    let queued = false;
    const update = () => {
      queued = false;
      show(Math.min(count - 1, Math.floor(progress() * count)));
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", request, { passive: true });
    addEventListener("resize", request);
    update();

    // A dot scrolls to the middle of its step's share of the scene.
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        const travel = walk.offsetHeight - sheet.offsetHeight;
        const top = walk.getBoundingClientRect().top + scrollY - stick();
        scrollTo({ top: top + ((i + 0.5) / count) * travel, behavior: "smooth" });
      })
    );
  }
</script>

<style>
  /* ---- The sheet: one screen of the app's gradient --------------------- */
  .sheet {
    background-color: var(--v-surface);
    background-image: var(--app-wash);
    padding-block: var(--section-gap);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s12);
  }
  .words {
    display: grid;
    gap: var(--s7);
    align-content: center;
  }
  .head {
    display: grid;
    gap: var(--s3);
  }
  .head .v-display {
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem);
  }
  .stage {
    display: grid;
    place-items: center;
  }
  .stage :global(.stage-phone) {
    width: min(100%, 300px);
  }

  .steps {
    display: grid;
    gap: var(--s7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: grid;
    gap: var(--s3);
    align-content: start;
    max-width: 30rem;
  }
  .num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--v-accent-soft);
    color: var(--v-accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }
  .is-pinned [data-on] > .num {
    background-image: linear-gradient(135deg, var(--v-accent), var(--v-accent-lime));
    color: var(--v-on-accent);
  }
  h3 {
    font-size: clamp(1.6rem, 1.25rem + 1.3vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .steps p {
    margin: 0;
    color: var(--v-text-secondary);
    font-size: var(--t-ui-large);
    line-height: 1.55;
  }

  .dots {
    display: none;
    gap: var(--s2);
  }
  .dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--v-fill-soft);
    cursor: pointer;
    transition:
      width 420ms var(--ease-spring),
      background-color var(--dur-base) ease;
  }
  .dots button[data-on] {
    width: 28px;
    background-image: linear-gradient(135deg, var(--v-accent), var(--v-accent-lime));
  }

  /* ---- Pinned: the scene is tall, the sheet sticks ---------------------- */
  /* The sheet fills the screen under the 64px header; each step gets 70% of
     a screen of scroll. */
  .walk.is-pinned {
    height: calc(100svh - 64px + var(--steps) * 70svh);
  }
  .is-pinned .sheet {
    position: sticky;
    top: 64px;
    height: calc(100svh - 64px);
    display: grid;
    align-items: center;
    padding-block: var(--s7);
    overflow: hidden;
  }
  .is-pinned .steps {
    gap: 0;
  }
  .is-pinned .steps li {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 360ms ease,
      transform 520ms var(--ease-spring);
  }
  .is-pinned .steps li[data-on] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .is-pinned .dots {
    display: flex;
  }
  /* The phone sized to the screen's height, so the whole sheet always fits. */
  .is-pinned .stage :global(.stage-phone) {
    width: min(300px, calc((100svh - 64px - 2 * var(--s7)) * 0.44));
  }

  /* ---- Phones: stacked in the one sheet -------------------------------- */
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
    }
    .words {
      display: contents;
    }
    .head {
      order: 1;
      gap: var(--s1);
    }
    .head .v-display {
      font-size: clamp(1.75rem, 1.2rem + 3vw, 2.25rem);
    }
    .stage {
      order: 2;
    }
    .steps {
      order: 3;
    }
    .dots {
      order: 4;
      justify-content: center;
    }
    .is-pinned .num {
      display: none;
    }
    h3 {
      font-size: 1.375rem;
    }
    .steps p {
      font-size: var(--t-ui-body);
    }
    .is-pinned .steps li {
      gap: var(--s1);
      text-align: center;
      justify-items: center;
      margin-inline: auto;
    }
    .is-pinned .sheet {
      padding-block: var(--s5);
    }
    .is-pinned .grid {
      align-content: center;
      gap: var(--s4);
    }
    /* The phone takes what the screen has left after the title, the step's
       words and the dots (about 330px), so the sheet always fits. */
    .is-pinned .stage :global(.stage-phone) {
      width: min(62vw, calc((100svh - 64px - 330px) * 0.46));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-pinned .steps li,
    .dots button {
      transition: none;
    }
    .is-pinned .steps li {
      transform: none;
    }
  }
</style>
