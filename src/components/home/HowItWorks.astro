---
/**
 * Signature scene two: the app, for real.
 *
 * Wide screens (Tom, 3 Oct 2026): one pinned sheet, the Apple product-page
 * pattern. The scene takes one screen's worth of space and holds under the
 * header while you scroll through it; the phone's bezel stays still and its
 * screen pushes across to each step in turn, the words crossfade beside it,
 * and the dots show where you are (click one to go there).
 *
 * Phones (Tom, 3 Oct 2026: "build this for phone"): no pinning. One phone
 * whose four screens are a native swipe inside it; tap the phone or a dot to
 * move on, and the words beneath follow. Light, and it scrolls like the
 * rest of the page.
 *
 * The script switches between the two at the 860px breakpoint. Without
 * JavaScript the scene is a plain section: the first screen and every step
 * listed. With reduced motion, changes are instant.
 */
import { screens, type Screen } from "../../data/screens";
import PhoneFrame from "../PhoneFrame.astro";

const steps: ReadonlyArray<{ title: string; body: string; screen: Screen }> = [
  {
    title: "Your map, front and centre",
    body: "Open the app and there’s England, county by county, your played courses glowing. Search for any course, or wander the map and see what’s near.",
    screen: screens.homeMap,
  },
  {
    title: "Tap to mark it played",
    body: "Every course has its own page: the facts, its outline from above, where it ranks. One tap and it’s yours. Nobody’s checking your handicap.",
    screen: screens.courseHankleySatellite,
  },
  {
    title: "Lists to work through",
    body: "The Top 100, the Open venues, every course in your county. Each one ticks down as you go. It gets moreish.",
    screen: screens.listTop100,
  },
  {
    title: "A collection to be proud of",
    body: "Your profile keeps the lot: courses played, counties finished, your top three. The kind of thing you show people at the bar.",
    screen: screens.profile,
  },
];
---

<section class="walk" aria-labelledby="walk-title" data-walk style={`--steps: ${steps.length}`}>
  <div class="sheet">
    <div class="v-container grid">
      <div class="words">
        <div class="head">
          <p class="v-kicker">The app</p>
          <h2 id="walk-title" class="v-display">Collecting courses, made simple.</h2>
        </div>

        <ol class="steps">
          {
            steps.map((step, i) => (
              <li data-step={i} data-on={i === 0 ? "" : undefined}>
                <span class="num v-tabular">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="dots" role="group" aria-label="Steps">
          {
            steps.map((step, i) => (
              <button
                type="button"
                data-go={i}
                data-on={i === 0 ? "" : undefined}
                aria-label={`Step ${i + 1}: ${step.title}`}
              />
            ))
          }
        </div>
      </div>

      <div class="stage" aria-hidden="true" data-stage>
        <PhoneFrame
          screen={steps[0].screen}
          more={steps.slice(1).map((step) => step.screen)}
          swipe
          maxWidth={300}
          class="stage-phone"
        />
      </div>
    </div>
  </div>
</section>

<script>
  for (const walk of document.querySelectorAll<HTMLElement>("[data-walk]")) {
    const sheet = walk.querySelector<HTMLElement>(".sheet")!;
    const stage = walk.querySelector<HTMLElement>("[data-stage]")!;
    const row = walk.querySelector<HTMLElement>("[data-layers]")!;
    const layers = walk.querySelectorAll<HTMLElement>("[data-layer]");
    const steps = walk.querySelectorAll<HTMLElement>("[data-step]");
    const dots = walk.querySelectorAll<HTMLButtonElement>("[data-go]");
    const count = steps.length;
    const wide = matchMedia("(min-width: 861px)");
    let current = -1;

    walk.classList.add("is-live");

    const show = (i: number) => {
      if (i === current) return;
      current = i;
      layers.forEach((layer) => {
        const n = Number(layer.dataset.layer);
        layer.dataset.state = n < i ? "before" : n === i ? "on" : "after";
      });
      steps.forEach((step, n) => step.toggleAttribute("data-on", n === i));
      dots.forEach((dot, n) => {
        dot.toggleAttribute("data-on", n === i);
        dot.setAttribute("aria-current", n === i ? "step" : "false");
      });
    };

    // The other screens load when the scene is near, not with the page.
    new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        walk.querySelectorAll<HTMLImageElement>("[data-layer] img").forEach((img) => (img.loading = "eager"));
        io.disconnect();
      },
      { rootMargin: "800px 0px" }
    ).observe(walk);

    // ---- Wide: pinned, scroll picks the step ----------------------------
    const stick = () => parseFloat(getComputedStyle(sheet).top) || 0;
    const progress = () => {
      const travel = walk.offsetHeight - sheet.offsetHeight;
      const moved = stick() - walk.getBoundingClientRect().top;
      return travel > 0 ? Math.min(1, Math.max(0, moved / travel)) : 0;
    };
    let queued = false;
    const onScroll = () => {
      queued = false;
      if (wide.matches) show(Math.min(count - 1, Math.floor(progress() * count)));
    };
    addEventListener(
      "scroll",
      () => {
        if (wide.matches && !queued) {
          queued = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );

    // ---- Phones: the swipe inside the phone picks the step --------------
    let swipeQueued = false;
    row.addEventListener(
      "scroll",
      () => {
        if (wide.matches || swipeQueued) return;
        swipeQueued = true;
        requestAnimationFrame(() => {
          swipeQueued = false;
          show(Math.round(row.scrollLeft / Math.max(1, row.clientWidth)));
        });
      },
      { passive: true }
    );
    const swipeTo = (i: number) => row.scrollTo({ left: i * row.clientWidth, behavior: "smooth" });
    stage.addEventListener("click", () => {
      if (!wide.matches) swipeTo((current + 1) % count);
    });

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        if (!wide.matches) return swipeTo(i);
        const travel = walk.offsetHeight - sheet.offsetHeight;
        const top = walk.getBoundingClientRect().top + scrollY - stick();
        scrollTo({ top: top + ((i + 0.5) / count) * travel, behavior: "smooth" });
      })
    );

    const mode = () => {
      walk.classList.toggle("is-pinned", wide.matches);
      current = -1;
      if (wide.matches) onScroll();
      else show(Math.round(row.scrollLeft / Math.max(1, row.clientWidth)));
    };
    wide.addEventListener("change", mode);
    mode();
  }
</script>

<style>
  /* ---- The sheet: one screen of the app's gradient --------------------- */
  .sheet {
    background-color: var(--v-surface);
    background-image: var(--app-wash);
    padding-block: var(--section-gap);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s12);
  }
  .words {
    display: grid;
    gap: var(--s7);
    align-content: center;
  }
  .head {
    display: grid;
    gap: var(--s3);
  }
  .head .v-display {
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem);
  }
  .stage {
    display: grid;
    place-items: center;
  }
  .stage :global(.stage-phone) {
    width: min(100%, 300px);
  }

  .steps {
    display: grid;
    gap: var(--s7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: grid;
    gap: var(--s3);
    align-content: start;
    max-width: 30rem;
  }
  .num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--v-accent-soft);
    color: var(--v-accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }
  .is-live [data-on] > .num {
    background-image: linear-gradient(135deg, var(--v-accent), var(--v-accent-lime));
    color: var(--v-on-accent);
  }
  h3 {
    font-size: clamp(1.6rem, 1.25rem + 1.3vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .steps p {
    margin: 0;
    color: var(--v-text-secondary);
    font-size: var(--t-ui-large);
    line-height: 1.55;
  }

  .dots {
    display: none;
    gap: var(--s2);
  }
  .dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--v-fill-soft);
    cursor: pointer;
    transition:
      width 420ms var(--ease-spring),
      background-color var(--dur-base) ease;
  }
  .dots button[data-on] {
    width: 28px;
    background-image: linear-gradient(135deg, var(--v-accent), var(--v-accent-lime));
  }

  /* ---- Pinned: the scene is tall, the sheet sticks ---------------------- */
  /* The sheet fills the screen under the 64px header; each step gets 70% of
     a screen of scroll. */
  .walk.is-pinned {
    height: calc(100svh - 64px + var(--steps) * 70svh);
  }
  .is-pinned .sheet {
    position: sticky;
    top: 64px;
    height: calc(100svh - 64px);
    display: grid;
    align-items: center;
    padding-block: var(--s7);
    overflow: hidden;
  }
  .is-live .steps {
    gap: 0;
  }
  .is-live .steps li {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 360ms ease,
      transform 520ms var(--ease-spring);
  }
  .is-live .steps li[data-on] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .is-live .dots {
    display: flex;
  }
  /* The phone sized to the screen's height, so the whole sheet always fits. */
  .is-pinned .stage :global(.stage-phone) {
    width: min(300px, calc((100svh - 64px - 2 * var(--s7)) * 0.44));
  }

  /* ---- Phones: a section like any other, the swipe inside the phone ---- */
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s6);
    }
    .words {
      display: contents;
    }
    .head {
      order: 1;
    }
    .head .v-display {
      font-size: clamp(2rem, 1.3rem + 3.6vw, 2.5rem);
    }
    .stage {
      order: 2;
      cursor: pointer;
    }
    .stage :global(.stage-phone) {
      width: min(64vw, 260px);
    }
    .steps {
      order: 3;
    }
    .dots {
      order: 4;
      justify-content: center;
    }
    .is-live .num {
      display: none;
    }
    h3 {
      font-size: 1.5rem;
    }
    .steps p {
      font-size: var(--t-ui-large);
    }
    .is-live .steps li {
      gap: var(--s2);
      text-align: center;
      justify-items: center;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-live .steps li,
    .dots button {
      transition: none;
    }
    .is-live .steps li {
      transform: none;
    }
  }
</style>
