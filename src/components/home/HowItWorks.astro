---
/**
 * How the app works, in three steps, beside a real photograph. The scroll
 * walkthrough of real app screens (signature scene two) replaces the photo
 * once the screenshots are in.
 */
import { Picture } from "astro:assets";
import { caption, photos } from "../../data/photos";
import HoleSketch from "../HoleSketch.astro";

const steps = [
  {
    title: "Find a course",
    body: "Search by name or wander the map. Every course in England is there, with Scotland and Wales on the way.",
  },
  {
    title: "Tap to mark it played",
    body: "One tap and it’s in your collection. Add a score if you like; nobody’s checking your handicap.",
  },
  {
    title: "Watch the map fill in",
    body: "Counties turn mint as you complete them. Lists like the Top 100 tick down. It gets moreish.",
  },
];
const photo = photos.teeHeather;
---

<section class="v-container how v-reveal" aria-labelledby="how-title">
  <figure class="photo">
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={["avif", "webp"]}
      widths={[480, 800, 1200]}
      sizes="(max-width: 860px) 100vw, 45vw"
      loading="lazy"
    />
    <figcaption>{caption(photo)}</figcaption>
  </figure>
  <div class="steps">
    <h2 id="how-title">Collecting courses, made simple.</h2>
    <ol>
      {
        steps.map((step, i) => (
          <li>
            <span class="num v-tabular">{i + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <HoleSketch class="sketch" />
  </div>
</section>

<style>
  .how {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s12);
    align-items: center;
    padding-block: var(--section-gap) 0;
  }
  .photo {
    position: relative;
    margin: 0;
    border-radius: var(--r-xxl);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    position: absolute;
    left: var(--s3);
    bottom: var(--s3);
    padding: var(--s1) var(--s3);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--v-on-photo-scrim) 45%, transparent);
    color: var(--v-on-photo);
    font-size: var(--t-ui-meta);
  }
  .steps {
    position: relative;
    display: grid;
    gap: var(--s7);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s6);
  }
  li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: var(--s4);
    align-items: start;
  }
  .num {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--v-accent-soft);
    color: var(--v-accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
  }
  li h3 {
    margin-bottom: var(--s1);
  }
  li p {
    color: var(--v-text-secondary);
  }
  .steps :global(.sketch) {
    justify-self: end;
    width: 96px;
    margin-top: calc(-1 * var(--s5));
    opacity: 0.85;
  }
  @media (max-width: 860px) {
    .how {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s7);
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
    .steps :global(.sketch) {
      display: none;
    }
  }
</style>
