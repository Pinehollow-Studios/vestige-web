---
/**
 * Signature scene two: the app, for real. On wide screens the phone pins
 * while four steps scroll past, and its screen changes to match the step
 * in view (a few lines of script below; without it, the first screen
 * stays and every step still reads). On phones each step carries its own
 * screen inline.
 */
import { screens, type Screen } from "../../data/screens";
import PhoneFrame from "../PhoneFrame.astro";

const steps: ReadonlyArray<{ title: string; body: string; screen: Screen }> = [
  {
    title: "Your map, front and centre",
    body: "Open the app and there’s England, county by county, your played courses glowing. Search for any course, or wander the map and see what’s near.",
    screen: screens.homeMap,
  },
  {
    title: "Tap to mark it played",
    body: "Every course has its own page: the facts, its outline from above, where it ranks. One tap and it’s yours. Add a score if you like; nobody’s checking your handicap.",
    screen: screens.courseHankleySatellite,
  },
  {
    title: "Lists to work through",
    body: "The Top 100, the Open venues, every course in your county. Each one ticks down as you go. It gets moreish.",
    screen: screens.listTop100,
  },
  {
    title: "A collection to be proud of",
    body: "Your profile keeps the lot: courses played, counties finished, your top three. The kind of thing you’ll show people at the bar.",
    screen: screens.profile,
  },
];
---

<section class="v-band walk" aria-labelledby="walk-title" data-walk>
  <div class="v-container">
    <div class="head v-reveal">
      <p class="v-kicker">The app</p>
      <h2 id="walk-title" class="v-display">Collecting courses, made simple.</h2>
      <p class="v-lead">Free on iPhone. No scorecards to fill in, no swing to fix. Just the places you’ve played.</p>
    </div>

    <div class="body">
      <div class="stage" aria-hidden="true">
        <div class="stack">
          {
            steps.map((step, i) => (
              <div class="slide" data-slide={i} data-on={i === 0 ? "" : undefined}>
                <PhoneFrame screen={step.screen} maxWidth={320} />
              </div>
            ))
          }
        </div>
      </div>

      <ol class="steps">
        {
          steps.map((step, i) => (
            <li data-step={i}>
              <span class="num v-tabular">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <ol class="swipe" aria-label="The app, step by step">
    {
      steps.map((step, i) => (
        <li class="card">
          <PhoneFrame screen={step.screen} maxWidth={260} />
          <div class="card-copy">
            <span class="num v-tabular">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="swipe-hint v-meta" aria-hidden="true">Swipe for more</p>
</section>

<script>
  // Swap the pinned phone's screen to the step in the middle of the view.
  for (const walk of document.querySelectorAll<HTMLElement>("[data-walk]")) {
    const slides = walk.querySelectorAll<HTMLElement>("[data-slide]");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const i = (entry.target as HTMLElement).dataset.step;
          slides.forEach((s) => s.toggleAttribute("data-on", s.dataset.slide === i));
        }
      },
      { rootMargin: "-45% 0px -45% 0px" }
    );
    walk.querySelectorAll("[data-step]").forEach((step) => observer.observe(step));
  }
</script>

<style>
  .head {
    display: grid;
    gap: var(--s4);
    max-width: 44rem;
    margin-bottom: var(--s12);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s12);
  }
  .stage {
    position: sticky;
    top: 96px;
    align-self: start;
    display: grid;
    justify-items: center;
  }
  .stack {
    display: grid;
    width: min(100%, 320px);
  }
  .slide {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition:
      opacity var(--dur-base) var(--ease-spring),
      transform 480ms var(--ease-spring);
  }
  .slide[data-on] {
    opacity: 1;
    transform: none;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    gap: var(--s3);
    align-content: center;
    min-height: 72svh;
    max-width: 30rem;
  }
  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--v-accent-soft);
    color: var(--v-accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
  }
  h3 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .steps p,
  .card-copy p {
    color: var(--v-text-secondary);
    font-size: var(--t-ui-large);
  }

  /* Phones: a swipeable row of screens instead of a long list. */
  .swipe,
  .swipe-hint {
    display: none;
  }
  @media (max-width: 860px) {
    .head {
      margin-bottom: var(--s7);
    }
    .body {
      display: none;
    }
    .swipe {
      display: flex;
      gap: var(--s4);
      list-style: none;
      margin: 0;
      padding: var(--s5) var(--page-gutter) var(--s4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter);
      scrollbar-width: none;
    }
    .swipe::-webkit-scrollbar {
      display: none;
    }
    .card {
      flex: 0 0 min(80vw, 320px);
      scroll-snap-align: start;
      display: grid;
      gap: var(--s5);
      align-content: start;
    }
    .card :global(.device) {
      width: 72%;
      justify-self: center;
    }
    .card-copy {
      display: grid;
      gap: var(--s2);
    }
    h3 {
      font-size: 1.625rem;
    }
    .swipe-hint {
      display: block;
      text-align: center;
      margin-top: var(--s2);
    }
  }
  /* The card in the middle of the row comes forward. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (max-width: 860px) {
      .card {
        animation-name: card-focus;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view(inline);
      }
    }
  }
  @keyframes card-focus {
    0% {
      opacity: 0.45;
      transform: scale(0.9);
    }
    35%,
    65% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0.45;
      transform: scale(0.9);
    }
  }
</style>
