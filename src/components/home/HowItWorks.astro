---
/**
 * Signature scene two: the app, for real.
 *
 * Wide screens: the phone pins while four steps scroll past. The bezel stays
 * still and its screen pushes across to the step in view, the way a screen
 * changes in the app; the step being shown lights up and its number takes
 * the gradient, with dots under the phone for where you are.
 *
 * Phones: a swipeable row of cards. The one in the middle comes forward and
 * the dots follow; tap a dot to jump. Both are driven by the script below
 * (IntersectionObserver), so they behave the same in every browser; without
 * script the first screen stays and every step still reads.
 */
import { screens, type Screen } from "../../data/screens";
import PhoneFrame from "../PhoneFrame.astro";

const steps: ReadonlyArray<{ title: string; body: string; screen: Screen }> = [
  {
    title: "Your map, front and centre",
    body: "Open the app and there’s England, county by county, your played courses glowing. Search for any course, or wander the map and see what’s near.",
    screen: screens.homeMap,
  },
  {
    title: "Tap to mark it played",
    body: "Every course has its own page: the facts, its outline from above, where it ranks. One tap and it’s yours. Add a score if you like; nobody’s checking your handicap.",
    screen: screens.courseHankleySatellite,
  },
  {
    title: "Lists to work through",
    body: "The Top 100, the Open venues, every course in your county. Each one ticks down as you go. It gets moreish.",
    screen: screens.listTop100,
  },
  {
    title: "A collection to be proud of",
    body: "Your profile keeps the lot: courses played, counties finished, your top three. The kind of thing you’ll show people at the bar.",
    screen: screens.profile,
  },
];
---

<section class="v-band walk" aria-labelledby="walk-title" data-walk>
  <div class="v-container">
    <div class="head v-reveal">
      <p class="v-kicker">The app</p>
      <h2 id="walk-title" class="v-display">Collecting courses, made simple.</h2>
      <p class="v-lead">Free on iPhone. No scorecards to fill in, no swing to fix. Just the places you’ve played.</p>
    </div>

    <div class="body">
      <div class="stage" aria-hidden="true">
        <PhoneFrame
          screen={steps[0].screen}
          more={steps.slice(1).map((step) => step.screen)}
          maxWidth={320}
          class="stage-phone"
        />
        <div class="dots">
          {steps.map((_, i) => <span data-dot={i} data-on={i === 0 ? "" : undefined} />)}
        </div>
      </div>

      <ol class="steps">
        {
          steps.map((step, i) => (
            <li data-step={i} data-on={i === 0 ? "" : undefined}>
              <span class="num v-tabular">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <ol class="swipe" aria-label="The app, step by step" data-swipe>
    {
      steps.map((step, i) => (
        <li class="card" data-card={i} data-on={i === 0 ? "" : undefined}>
          <PhoneFrame screen={step.screen} maxWidth={260} />
          <div class="card-copy">
            <span class="num v-tabular">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <div class="swipe-dots" data-swipe-dots>
    {
      steps.map((step, i) => (
        <button type="button" data-go={i} data-on={i === 0 ? "" : undefined} aria-label={`Step ${i + 1}: ${step.title}`} />
      ))
    }
  </div>
</section>

<script>
  const mark = (els: Iterable<Element>, key: string, i: number) => {
    for (const el of els) el.toggleAttribute("data-on", (el as HTMLElement).dataset[key] === String(i));
  };

  for (const walk of document.querySelectorAll<HTMLElement>("[data-walk]")) {
    walk.classList.add("is-live");
    // Wide: the pinned phone follows the step in the middle of the view.
    const layers = walk.querySelectorAll<HTMLElement>(".stage [data-layer]");
    const steps = walk.querySelectorAll<HTMLElement>("[data-step]");
    const dots = walk.querySelectorAll<HTMLElement>("[data-dot]");
    const show = (i: number) => {
      layers.forEach((layer) => {
        const n = Number(layer.dataset.layer);
        layer.dataset.state = n < i ? "before" : n === i ? "on" : "after";
      });
      mark(steps, "step", i);
      mark(dots, "dot", i);
    };
    const stepWatch = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) show(Number((entry.target as HTMLElement).dataset.step));
        }
      },
      { rootMargin: "-45% 0px -45% 0px" }
    );
    steps.forEach((step) => stepWatch.observe(step));

    // Phones: the card in the middle comes forward; the dots follow and jump.
    const row = walk.querySelector<HTMLElement>("[data-swipe]");
    const cards = walk.querySelectorAll<HTMLElement>("[data-card]");
    const go = walk.querySelectorAll<HTMLButtonElement>("[data-go]");
    if (row) {
      row.classList.add("is-live");
      const cardWatch = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const i = Number((entry.target as HTMLElement).dataset.card);
            mark(cards, "card", i);
            mark(go, "go", i);
          }
        },
        { root: row, threshold: 0.6 }
      );
      cards.forEach((card) => cardWatch.observe(card));
      go.forEach((button) =>
        button.addEventListener("click", () => {
          const card = cards[Number(button.dataset.go)];
          row.scrollTo({ left: card.offsetLeft - row.offsetLeft - parseFloat(getComputedStyle(row).scrollPaddingLeft || "0"), behavior: "smooth" });
        })
      );
    }
  }
</script>

<style>
  .head {
    display: grid;
    gap: var(--s4);
    max-width: 44rem;
    margin-bottom: var(--s12);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s12);
  }
  .stage {
    position: sticky;
    top: 96px;
    align-self: start;
    display: grid;
    justify-items: center;
  }
  .stage :global(.stage-phone) {
    width: min(100%, 320px);
  }
  .dots {
    display: flex;
    gap: var(--s2);
    margin-top: var(--s7);
  }
  .dots span,
  .swipe-dots button {
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--v-fill-soft);
    transition:
      width 420ms var(--ease-spring),
      background-color var(--dur-base) ease;
  }
  .dots span[data-on],
  .swipe-dots button[data-on] {
    width: 28px;
    background-image: linear-gradient(135deg, var(--v-accent), var(--v-accent-lime));
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    gap: var(--s3);
    align-content: center;
    min-height: 72svh;
    max-width: 30rem;
    transition:
      opacity 420ms var(--ease-spring),
      transform 520ms var(--ease-spring);
  }
  /* With the script running, the step being shown lights up. */
  .walk.is-live .steps li:not([data-on]) {
    opacity: 0.32;
    transform: translateX(-8px);
  }
  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--v-accent-soft);
    color: var(--v-accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease;
  }
  [data-on] > .num,
  .card[data-on] .num {
    background-image: linear-gradient(135deg, var(--v-accent), var(--v-accent-lime));
    color: var(--v-on-accent);
  }
  h3 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .steps p,
  .card-copy p {
    color: var(--v-text-secondary);
    font-size: var(--t-ui-large);
  }

  /* Phones: a swipeable row of screens instead of a long list. */
  .swipe,
  .swipe-dots {
    display: none;
  }
  @media (max-width: 860px) {
    .head {
      margin-bottom: var(--s7);
    }
    .body {
      display: none;
    }
    .swipe {
      display: flex;
      gap: var(--s4);
      list-style: none;
      margin: 0;
      padding: var(--s5) var(--page-gutter) var(--s4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter);
      scrollbar-width: none;
    }
    .swipe::-webkit-scrollbar {
      display: none;
    }
    .card {
      flex: 0 0 min(80vw, 320px);
      scroll-snap-align: start;
      display: grid;
      gap: var(--s5);
      align-content: start;
    }
    .card :global(.device) {
      width: 72%;
      justify-self: center;
    }
    .card-copy {
      display: grid;
      gap: var(--s2);
    }
    h3 {
      font-size: 1.625rem;
    }
    .swipe-dots {
      display: flex;
      justify-content: center;
      gap: var(--s2);
      margin-top: var(--s3);
    }
    .swipe-dots button {
      padding: 0;
      border: 0;
      cursor: pointer;
    }
    /* With the script running, the card in the middle comes forward. */
    .swipe.is-live .card {
      transition:
        transform 520ms var(--ease-spring),
        opacity 420ms var(--ease-spring);
    }
    .swipe.is-live .card:not([data-on]) {
      opacity: 0.5;
      transform: scale(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steps li,
    .swipe.is-live .card {
      transition: none;
    }
    .walk.is-live .steps li:not([data-on]) {
      transform: none;
    }
    .swipe.is-live .card:not([data-on]) {
      transform: none;
    }
  }
</style>
