---
/**
 * The social side: a polite competition. A full-bleed photograph band with
 * the copy over it, cream on a scrim.
 */
import { Picture } from "astro:assets";
import { caption, photos } from "../../data/photos";
import { screens } from "../../data/screens";
import PhoneFrame from "../PhoneFrame.astro";

const photo = photos.arthursSeat;
---

<section class="friends v-reveal" aria-labelledby="friends-title">
  <Picture
    src={photo.src}
    alt={photo.alt}
    formats={["avif", "webp"]}
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="(max-width: 760px) and (min-resolution: 3dppx) 67vw, 100vw"
    loading="lazy"
    class="bg"
  />
  <div class="scrim" aria-hidden="true"></div>
  <div class="v-container content">
    <div class="text">
      <h2 id="friends-title" class="v-display">A polite competition.</h2>
      <p>
        Add your friends and see whose collection runs deepest. Who’s finished Surrey, who’s
        never been north of Watford, who keeps claiming they’ve played St Andrews.
      </p>
    </div>
    <PhoneFrame screen={screens.feedRound} maxWidth={260} class="friends-phone" />
  </div>
  <p class="credit">{caption(photo)}</p>
</section>

<style>
  .friends {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(88svh, 820px);
    margin-top: var(--section-gap);
    overflow: hidden;
    color: var(--v-on-photo);
  }
  .friends :global(.bg),
  .friends :global(.bg img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    z-index: -2;
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--v-on-photo-scrim) 62%, transparent) 0%,
      color-mix(in srgb, var(--v-on-photo-scrim) 24%, transparent) 45%,
      transparent 70%
    );
  }
  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s12);
    padding-block: var(--s16);
  }
  .text {
    display: grid;
    gap: var(--s4);
  }
  .content :global(.friends-phone) {
    width: 240px;
  }
  @media (max-width: 860px) {
    .content {
      grid-template-columns: minmax(0, 1fr);
    }
    .content :global(.friends-phone) {
      display: none;
    }
  }
  h2 {
    color: var(--v-on-photo);
  }
  .content p {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.25rem);
    color: color-mix(in srgb, var(--v-on-photo) 92%, transparent);
  }
  .credit {
    position: absolute;
    right: var(--page-gutter);
    bottom: var(--s5);
    font-size: var(--t-ui-meta);
    color: color-mix(in srgb, var(--v-on-photo) 80%, transparent);
  }
</style>
