---
/**
 * The page's one primary call to action (the gradient button): word of
 * version 1.0. Posts to /api/notify (Resend + Supabase + the welcome
 * email). With JavaScript it submits in place; without, the form posts and
 * the endpoint redirects back with ?joined=1. A `?from=` tag on the page
 * URL rides along as the signup's source; `website` is a honeypot.
 */
---

<section class="v-band signup" id="notify" aria-labelledby="signup-title">
  <div class="v-container">
  <div class="v-card panel v-reveal">
    <div class="copy">
      <p class="v-label">Coming in January</p>
      <h2 id="signup-title" class="v-display">Version 1.0 is nearly here.</h2>
      <p class="v-lead">
        Leave your email and we’ll tell you the day it’s on the App Store. Free, iPhone only, and
        we won’t fill your inbox. The odd postcard from the map at most.
      </p>
    </div>
    <form class="form" method="post" action="/api/notify" data-notify>
      <input type="hidden" name="source" value="" />
      <div class="trap" aria-hidden="true">
        <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <label class="v-visually-hidden" for="signup-email">Email address</label>
      <input
        id="signup-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@example.co.uk"
        required
      />
      <button class="v-button v-button--primary" type="submit">Keep me posted</button>
      <p class="status" role="status" aria-live="polite" data-status></p>
      <p class="v-meta fine">
        iPhone, iOS 26 or later. We’ll only email you about Vestige. <a href="/privacy">Privacy</a>
      </p>
    </form>
  </div>
  </div>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-notify]")) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const source = form.querySelector<HTMLInputElement>('input[name="source"]')!;
    source.value = new URLSearchParams(location.search).get("from") ?? "";

    const joined = new URLSearchParams(location.search).get("joined");
    if (joined === "1") status.textContent = "You’re on the list. Check your inbox for a welcome note.";
    if (joined === "0") status.textContent = "That didn’t go through. Try again in a moment.";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "Saving…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (body.ok) {
          form.reset();
          source.value = new URLSearchParams(location.search).get("from") ?? "";
          status.textContent = "You’re on the list. Check your inbox for a welcome note.";
        } else {
          status.textContent = body.error ?? "That didn’t go through. Try again in a moment.";
        }
      } catch {
        status.textContent = "That didn’t go through. Try again in a moment.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .status:empty {
    display: none;
  }
  .status {
    font-weight: 600;
    color: var(--v-accent-ink);
  }
  .signup {
    margin-top: var(--section-gap);
  }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s12);
    align-items: center;
    padding: clamp(var(--s7), 5vw, var(--s16));
    border-radius: var(--r-xxl);
  }
  .copy {
    display: grid;
    gap: var(--s4);
  }
  .form {
    display: grid;
    gap: var(--s3);
  }
  input {
    min-height: 56px;
    padding: 0 var(--s5);
    border: 1px solid var(--v-border);
    border-radius: var(--r-lg);
    background: var(--v-surface);
    font: inherit;
    font-size: 17px;
    color: var(--v-text-primary);
  }
  input:focus {
    outline: 2px solid var(--v-accent-ink);
    outline-offset: 2px;
  }
  .v-button {
    width: 100%;
    min-height: 56px;
  }
  .fine a {
    color: inherit;
  }
  @media (max-width: 860px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s7);
    }
  }
</style>
