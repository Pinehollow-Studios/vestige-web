---
/**
 * The page's one primary call to action (the gradient button): word of
 * version 1.0. The form is wired to an Astro Action (Resend + Supabase)
 * in the next step of release 1; until then it posts nowhere.
 */
---

<section class="v-container signup v-reveal" id="notify" aria-labelledby="signup-title">
  <div class="v-card panel">
    <div class="copy">
      <p class="v-label">Coming in January</p>
      <h2 id="signup-title">Version 1.0 is nearly here.</h2>
      <p class="v-lead">
        Leave your email and we’ll tell you the day it’s on the App Store. Free, iPhone only, and
        we won’t fill your inbox. The odd postcard from the map at most.
      </p>
    </div>
    <form class="form" method="post" action="#notify">
      <label class="v-visually-hidden" for="signup-email">Email address</label>
      <input
        id="signup-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@example.co.uk"
        required
      />
      <button class="v-button v-button--primary" type="submit">Keep me posted</button>
      <p class="v-meta fine">
        iPhone, iOS 26 or later. We’ll only email you about Vestige. <a href="/privacy">Privacy</a>
      </p>
    </form>
  </div>
</section>

<style>
  .signup {
    padding-block: var(--section-gap) 0;
  }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s12);
    align-items: center;
    padding: clamp(var(--s7), 5vw, var(--s16));
    border-radius: var(--r-xxl);
  }
  .copy {
    display: grid;
    gap: var(--s4);
  }
  .form {
    display: grid;
    gap: var(--s3);
  }
  input {
    min-height: 56px;
    padding: 0 var(--s5);
    border: 1px solid var(--v-border);
    border-radius: var(--r-lg);
    background: var(--v-surface);
    font: inherit;
    font-size: 17px;
    color: var(--v-text-primary);
  }
  input:focus {
    outline: 2px solid var(--v-accent-ink);
    outline-offset: 2px;
  }
  .v-button {
    width: 100%;
    min-height: 56px;
  }
  .fine a {
    color: inherit;
  }
  @media (max-width: 860px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s7);
    }
  }
</style>
