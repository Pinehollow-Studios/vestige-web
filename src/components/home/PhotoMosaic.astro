---
/**
 * "Wherever you play": real courses from our own rounds, big and small,
 * north and south. Captions say where, as far as we can vouch for it.
 */
import { Picture } from "astro:assets";
import { caption, photos } from "../../data/photos";

const tiles = [
  { photo: photos.arthursSeat, shape: "tall" },
  { photo: photos.manchesterSkyline, shape: "wide" },
  { photo: photos.pinesSunset, shape: "tall" },
  { photo: photos.pineRidge, shape: "tall" },
] as const;
---

<section class="v-container mosaic-section v-reveal" aria-labelledby="mosaic-title">
  <div class="intro">
    <p class="v-kicker">Every course</p>
    <h2 id="mosaic-title" class="v-display">Wherever you play, it’s on the map.</h2>
    <p class="v-lead">
      Heathland classics, clifftop links, the municipal with the view of the gasworks. If it’s a
      golf course in Britain, it counts.
    </p>
  </div>
  <div class="mosaic">
    {
      tiles.map(({ photo, shape }) => (
        <figure class:list={["tile", shape]}>
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={["avif", "webp"]}
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) and (min-resolution: 3dppx) 55vw, (max-width: 760px) 82vw, 40vw"
            loading="lazy"
          />
          <figcaption>{caption(photo)}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .mosaic-section {
    display: grid;
    gap: var(--s7);
    padding-block: var(--section-gap) 0;
  }
  .intro {
    display: grid;
    gap: var(--s4);
    max-width: 40rem;
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 120px;
    gap: var(--s4);
  }
  .tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-xxl);
  }
  .tile:nth-child(1) {
    grid-column: 1 / span 4;
    grid-row: span 4;
  }
  .tile:nth-child(2) {
    grid-column: 5 / span 8;
    grid-row: span 2;
  }
  .tile:nth-child(3) {
    grid-column: 5 / span 4;
    grid-row: span 2;
  }
  .tile:nth-child(4) {
    grid-column: 9 / span 4;
    grid-row: span 2;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-spring);
  }
  .tile:hover :global(img) {
    transform: scale(1.03);
  }
  figcaption {
    position: absolute;
    left: var(--s3);
    bottom: var(--s3);
    padding: var(--s1) var(--s3);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--v-on-photo-scrim) 45%, transparent);
    color: var(--v-on-photo);
    font-size: var(--t-ui-meta);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* Phones: a swipeable row of tall photographs, edge to edge. */
  @media (max-width: 760px) {
    .mosaic {
      display: flex;
      gap: var(--s3);
      margin-inline: calc(-1 * var(--page-gutter));
      padding-inline: var(--page-gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter);
      scrollbar-width: none;
    }
    .mosaic::-webkit-scrollbar {
      display: none;
    }
    .tile:nth-child(n) {
      flex: 0 0 82vw;
      aspect-ratio: 4 / 5;
      scroll-snap-align: start;
    }
  }
</style>
