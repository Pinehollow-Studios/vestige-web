---
/**
 * Signature scene one: the map of Britain filling in. England's 47 counties
 * turn mint south to north (the order the course database was built in) and
 * a counter climbs to 47. Scotland and Wales sit beside it, marked as next.
 *
 * Wide screens: the scene pins and the fill follows the scroll (a CSS
 * scroll-driven animation on a view timeline; the counter is a few lines of
 * script on the same range).
 *
 * Phones (Tom, 3 Oct 2026): no pinning. When the map comes into view the
 * counties fill and the count runs 0 to 47 once, in under two seconds.
 *
 * Without JavaScript, without scroll-driven animation support on wide
 * screens, or with reduced motion asked for, the map and the count simply
 * show their finished state.
 */
import { COUNTY_SHAPES, COUNTY_VIEW } from "../../data/counties";
import { COUNTRY_SHAPES } from "../../data/countries";
import { progressConfig, COUNTIES_TOTAL } from "../../data/progressConfig";

// South to north, as the database was built.
const counties = [...COUNTY_SHAPES].sort((a, b) => b.cy - a.cy);
const courses = progressConfig.coursesMapped.toLocaleString("en-GB");
---

<section class="map-scene" aria-labelledby="map-title">
  <div class="sticky">
    <div class="v-container layout">
      <div class="copy">
        <p class="v-kicker">The map so far</p>
        <h2 id="map-title" class="v-display">England, done. Every last course.</h2>
        <p class="v-lead">
          All {courses} golf courses in England are on the map, from Open venues to the nine-holer
          behind the leisure centre. Scotland and Wales are next.
        </p>
        <p class="tally" aria-hidden="true">
          <span class="count v-hero-numeral v-tabular" data-count>{COUNTIES_TOTAL}</span>
          <span class="v-meta">of {COUNTIES_TOTAL} counties mapped</span>
        </p>
        <p class="v-visually-hidden">All {COUNTIES_TOTAL} counties of England are mapped.</p>
      </div>
      <figure class="map">
        <svg
          viewBox={`0 0 ${COUNTY_VIEW.w} ${COUNTY_VIEW.h}`}
          role="img"
          aria-label={`Map of Great Britain with all ${COUNTIES_TOTAL} English counties filled in, and Scotland and Wales still to come.`}
        >
          <g class="next">
            {COUNTRY_SHAPES.map((c) => <path d={c.d} fill-rule="evenodd" />)}
            {
              COUNTRY_SHAPES.map((c) => (
                <text x={c.lx} y={c.ly} text-anchor="middle">
                  {c.name}, next
                </text>
              ))
            }
          </g>
          <g class="counties">
            {
              counties.map((s, i) => (
                <path
                  d={s.d}
                  fill-rule="evenodd"
                  style={`--o: ${((i / counties.length) * 78).toFixed(2)}%; --d: ${Math.round((i / counties.length) * 1300)}ms`}
                />
              ))
            }
          </g>
        </svg>
      </figure>
    </div>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>(".map-scene");
  const out = scene?.querySelector<HTMLElement>("[data-count]");
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wide = matchMedia("(min-width: 861px)").matches;
  const timelines = CSS.supports("animation-timeline: view()");

  if (scene && out && !calm && wide && timelines) {
    // Wide: the count follows the scroll, 0 as the map pins, 47 as the last
    // county fills (84% of the way through, the end of the fill's range).
    const total = Number(out.textContent) || 47;
    let queued = false;
    const update = () => {
      queued = false;
      const box = scene.getBoundingClientRect();
      const travel = box.height - innerHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, -box.top / travel)) : 1;
      const n = String(Math.round(Math.min(1, progress / 0.84) * total));
      if (out.textContent !== n) out.textContent = n;
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", request, { passive: true });
    addEventListener("resize", request);
    update();
  } else if (scene && out && !calm && !wide) {
    // Phones: fill once, when the map comes into view.
    const total = Number(out.textContent) || 47;
    scene.classList.add("is-armed");
    out.textContent = "0";
    new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        scene.classList.add("is-filled");
        const start = performance.now();
        const run = (now: number) => {
          const t = Math.min(1, (now - start) / 1700);
          out.textContent = String(Math.round((1 - Math.pow(1 - t, 3)) * total));
          if (t < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
      },
      { threshold: 0.45 }
    ).observe(scene.querySelector(".map") ?? scene);
  }
</script>

<style>
  .map-scene {
    position: relative;
    view-timeline-name: --map;
    view-timeline-axis: block;
  }
  .sticky {
    padding-block: var(--section-gap);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: var(--s12);
  }
  .copy {
    display: grid;
    gap: var(--s4);
    align-content: center;
  }
  .tally {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    margin-top: var(--s4);
  }
  .count {
    display: inline-block;
    min-width: 2ch;
    text-align: right;
    color: var(--v-accent-ink);
  }
  .map {
    margin: 0;
    padding: var(--s6);
    background: var(--v-surface-raised);
    box-shadow: var(--card-edge);
    border-radius: var(--r-xxl);
  }
  .map svg {
    width: 100%;
    max-height: 78svh;
  }
  .counties path {
    fill: var(--v-accent);
    stroke: var(--v-surface-raised);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  .next path {
    fill: var(--v-fill-soft);
    stroke: var(--v-surface-raised);
    stroke-width: 0.8;
  }
  .next text {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    fill: var(--v-text-secondary);
  }

  /* The scroll story on wide screens, where the browser can tell it. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 861px) {
      .map-scene {
        height: 260vh;
      }
      .sticky {
        position: sticky;
        top: 0;
        min-height: 100svh;
        display: grid;
        align-items: center;
        padding-block: var(--s16) var(--s12);
      }
      .counties path {
        fill: var(--v-fill-soft);
        animation: county-fill linear both;
        animation-timeline: --map;
        animation-range: contain var(--o) contain calc(var(--o) + 6%);
      }
    }
  }

  /* Phones: fill once, when the map arrives (the script adds the classes). */
  .is-armed .counties path {
    fill: var(--v-fill-soft);
    transition: fill 520ms ease var(--d);
  }
  .is-armed.is-filled .counties path {
    fill: var(--v-accent);
  }

  @keyframes county-fill {
    0% {
      fill: var(--v-fill-soft);
    }
    40% {
      fill: var(--v-ramp-moss);
    }
    70% {
      fill: var(--v-ramp-pine);
    }
    100% {
      fill: var(--v-accent);
    }
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }
    .tally {
      margin-top: 0;
    }
    .map {
      padding: var(--s4);
    }
    .map svg {
      max-height: 62svh;
      margin-inline: auto;
    }
  }
</style>
