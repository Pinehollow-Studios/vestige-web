---
/**
 * The site header. It floats over the page, so it is chrome and may be
 * glass (design kit §8.4): one translucent fill, a hairline in light only.
 * The header's call to action is secondary; the gradient is reserved for
 * the page's own hero call to action.
 */
import Lockup from "./Lockup.astro";
import { nav } from "../config/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="v-container bar">
    <a class="home" href="/" aria-label="Vestige, home"><Lockup /></a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="v-button v-button--secondary cta" href="/#notify">Get notified</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--v-surface-glass);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-bottom: 1px solid var(--v-separator);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s6);
    min-height: 64px;
  }
  .home {
    text-decoration: none;
    flex: none;
  }
  nav {
    flex: 1;
  }
  ul {
    display: flex;
    gap: var(--s5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--v-text-secondary);
    font-size: var(--t-ui-body);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-spring);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--v-text-primary);
  }
  .cta {
    min-height: 40px;
    padding: 0 var(--s4);
    font-size: var(--t-ui-body);
    border-radius: var(--r-md);
  }
  @media (max-width: 560px) {
    .bar {
      gap: var(--s4);
    }
    .cta {
      display: none;
    }
    nav ul {
      justify-content: flex-end;
      gap: var(--s4);
    }
  }
</style>
