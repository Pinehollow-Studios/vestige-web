---
/**
 * A real app screenshot in an iPhone-shaped frame, drawn in CSS so it
 * stays crisp at any size: a near-black bezel, the screen's own rounded
 * corners and the Dynamic Island. Always upright. Behind it, a soft pool
 * of mint and blue light; beneath it, a gentle shadow on the ground, so it
 * sits in the page rather than on it. Width is set by the parent; the
 * frame keeps the 1206 x 2622 screen's proportions. With `more`, the
 * screen holds several layers that slide across behind a still bezel.
 */
import { Picture } from "astro:assets";
import type { Screen } from "../data/screens";

interface Props {
  screen: Screen;
  /**
   * More screens behind the first, for a phone whose screen changes while
   * the bezel stays put (the homepage walkthrough). Each is a layer marked
   * data-layer={i}; the page decides which is showing.
   */
  more?: ReadonlyArray<Screen>;
  /** Rendered width in CSS px at its largest, for responsive image sizes. */
  maxWidth?: number;
  loading?: "lazy" | "eager";
  class?: string;
}
const { screen, more = [], maxWidth = 320, loading = "lazy", class: className } = Astro.props;
const layered = more.length > 0;
---

<div class:list={["device", className]}>
  <div class="phone">
  <div class="screen">
    {
      layered ? (
        [screen, ...more].map((sc, i) => (
          <div class="layer" data-layer={i} data-state={i === 0 ? "on" : "after"}>
            {/* Eager: a layer waiting off to the side is clipped, so lazy
                loading could hold it back until it slides in, black. */}
            <Picture
              src={sc.src}
              alt={i === 0 ? sc.alt : ""}
              formats={["avif", "webp"]}
              widths={[maxWidth, Math.min(maxWidth * 2, 1206), Math.min(maxWidth * 3, 1206)]}
              sizes={`${maxWidth}px`}
              loading="eager"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        ))
      ) : (
        <Picture
          src={screen.src}
          alt={screen.alt}
          formats={["avif", "webp"]}
          widths={[maxWidth, Math.min(maxWidth * 2, 1206), Math.min(maxWidth * 3, 1206)]}
          sizes={`${maxWidth}px`}
          loading={loading}
        />
      )
    }
    <span class="island" aria-hidden="true"></span>
  </div>
  </div>
</div>

<style>
  .device {
    position: relative;
    isolation: isolate;
  }
  /* The glow: the app's mint at the heart, its lime at the edge. */
  .device::before {
    content: "";
    position: absolute;
    inset: 4% -34% 8%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--v-accent) 42%, transparent) 0%,
      color-mix(in srgb, var(--v-accent-lime) 22%, transparent) 55%,
      transparent 100%
    );
    filter: blur(32px);
    opacity: 0.9;
  }
  /* The ground shadow. */
  .device::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -3.5%;
    height: 6%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(11 15 20 / 0.32), transparent);
    filter: blur(8px);
  }
  .phone {
    --bezel: clamp(6px, 3.2%, 12px);
    position: relative;
    width: 100%;
    padding: var(--bezel);
    border-radius: 15% / 7%;
    background: #0b0f14;
    box-shadow:
      inset 0 0 0 1.5px #3a4350,
      0 0 0 1px rgb(14 24 34 / 0.18);
  }
  .screen {
    position: relative;
    overflow: hidden;
    border-radius: 12.5% / 5.9%;
    aspect-ratio: 1206 / 2622;
    background: #070a10;
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Layered screens: the showing one in place, earlier ones pushed left and
     dimmed, later ones waiting off to the right, like a screen pushing on. */
  .layer {
    position: absolute;
    inset: 0;
    transition:
      transform 620ms var(--ease-spring),
      filter 620ms var(--ease-spring);
  }
  .layer[data-state="on"] {
    z-index: 2;
    transform: none;
  }
  .layer[data-state="before"] {
    z-index: 1;
    transform: translateX(-28%);
    filter: brightness(0.55);
  }
  .layer[data-state="after"] {
    z-index: 3;
    transform: translateX(102%);
  }
  .layer[data-state="on"] + .layer[data-state="after"] {
    box-shadow: -12px 0 24px rgb(0 0 0 / 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .layer {
      transition: opacity var(--dur-base) ease;
    }
    .layer[data-state="before"],
    .layer[data-state="after"] {
      transform: none;
      opacity: 0;
      filter: none;
    }
  }
  .island {
    position: absolute;
    top: 1.35%;
    left: 50%;
    width: 30%;
    height: 3.9%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
</style>
