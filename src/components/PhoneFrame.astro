---
/**
 * A real app screenshot in an iPhone-shaped frame, drawn in CSS so it
 * stays crisp at any size: a near-black bezel, the screen's own rounded
 * corners and the Dynamic Island. Width is set by the parent; the frame
 * keeps the 1206 x 2622 screen's proportions.
 */
import { Picture } from "astro:assets";
import type { Screen } from "../data/screens";

interface Props {
  screen: Screen;
  /** Rendered width in CSS px at its largest, for responsive image sizes. */
  maxWidth?: number;
  loading?: "lazy" | "eager";
  class?: string;
}
const { screen, maxWidth = 320, loading = "lazy", class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="screen">
    <Picture
      src={screen.src}
      alt={screen.alt}
      formats={["avif", "webp"]}
      widths={[maxWidth, Math.min(maxWidth * 2, 1206), Math.min(maxWidth * 3, 1206)]}
      sizes={`${maxWidth}px`}
      loading={loading}
    />
    <span class="island" aria-hidden="true"></span>
  </div>
</div>

<style>
  .phone {
    --bezel: clamp(6px, 3.2%, 12px);
    position: relative;
    width: 100%;
    padding: var(--bezel);
    border-radius: 15% / 7%;
    background: #0b0f14;
    box-shadow:
      inset 0 0 0 1.5px #3a4350,
      0 0 0 1px rgb(14 24 34 / 0.18);
  }
  .screen {
    position: relative;
    overflow: hidden;
    border-radius: 12.5% / 5.9%;
    aspect-ratio: 1206 / 2622;
    background: #070a10;
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .island {
    position: absolute;
    top: 1.35%;
    left: 50%;
    width: 30%;
    height: 3.9%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
</style>
