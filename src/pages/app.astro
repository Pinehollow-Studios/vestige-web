---
/**
 * /app: what Vestige does, screen by screen, the questions people ask, and
 * the 1.0 signup. Real screens throughout.
 */
import Base from "../layouts/Base.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Signup from "../components/home/Signup.astro";
import { screens, type Screen } from "../data/screens";
import { faq } from "../data/faq";
import { progressConfig } from "../data/progressConfig";

const courses = progressConfig.coursesMapped.toLocaleString("en-GB");
const features: ReadonlyArray<{ title: string; body: string; screen: Screen }> = [
  {
    title: "Your map, filling in.",
    body: `Every course you mark lands on a map of England's counties, all ${courses} courses of it. Finish a county and it turns mint. Scotland and Wales are next.`,
    screen: screens.homeMap,
  },
  {
    title: "A page for every course.",
    body: "The facts, the outline from above, where it ranks and what makes it special. Tap once and it’s in your collection. Add a score if you like.",
    screen: screens.courseHankley,
  },
  {
    title: "Lists worth chasing.",
    body: "The Top 100, the Open venues, every course in your county. Each one ticks down as you go, and some take a lifetime.",
    screen: screens.listTop100,
  },
  {
    title: "A plan for next time.",
    body: "Save the ones you’re after and Vestige keeps them in order, with the nearest up next. Handy when there’s a free Saturday.",
    screen: screens.toPlay,
  },
  {
    title: "Your friends, your feed.",
    body: "See where your friends have been playing, with their photos and scores, and see whose collection runs deepest. No follower counts, no strangers.",
    screen: screens.feedRound,
  },
];
---

<Base title="The app" description="Vestige for iPhone: every golf course in Britain on one map. Mark the ones you’ve played, fill in your counties and compare with friends.">
  <section class="v-container intro">
    <div class="copy">
      <p class="v-label">Vestige for iPhone</p>
      <h1>Every course you’ve played, in your pocket.</h1>
      <p class="v-lead">
        No swing analysis, no data dashboards. Just somewhere to keep the places you’ve played,
        mark a score if you like, and see how your collection stands.
      </p>
      <a class="v-button v-button--secondary" href="#notify">Tell me when it’s out</a>
    </div>
    <PhoneFrame screen={screens.courseWentworth} maxWidth={300} loading="eager" class="intro-phone" />
  </section>

  <div class="v-container features">
    {
      features.map((f, i) => (
        <section class:list={["feature", "v-reveal", { flip: i % 2 === 1 }]}>
          <PhoneFrame screen={f.screen} maxWidth={280} class="feature-phone" />
          <div class="feature-copy">
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </div>
        </section>
      ))
    }
  </div>

  <section class="v-container faq v-reveal" aria-labelledby="faq-title">
    <h2 id="faq-title">Before you ask.</h2>
    <div class="items">
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>
              {item.a}
              {item.link && (
                <>
                  {" "}
                  <a href={item.link.href}>{item.link.label}</a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <Signup />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s12);
    padding-block: var(--s16) 0;
  }
  .copy {
    display: grid;
    gap: var(--s5);
    justify-items: start;
    max-width: 40rem;
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .intro :global(.intro-phone) {
    width: 280px;
  }
  .features {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap) 0;
  }
  .feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(var(--s7), 8vw, var(--s24));
  }
  .feature.flip {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .feature.flip :global(.feature-phone) {
    order: 2;
  }
  .feature :global(.feature-phone) {
    width: 260px;
  }
  .feature-copy {
    display: grid;
    gap: var(--s4);
    max-width: 30rem;
  }
  .feature-copy h2 {
    font-size: var(--t-h1);
    letter-spacing: -0.02em;
  }
  .feature-copy p {
    color: var(--v-text-secondary);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
  }
  .faq {
    max-width: calc(760px + 2 * var(--page-gutter));
    padding-block: var(--section-gap) 0;
  }
  .items {
    margin-top: var(--s7);
    background: var(--v-surface-raised);
    box-shadow: var(--card-edge);
    border-radius: var(--r-xl);
  }
  details {
    margin: 0 var(--s6);
  }
  details + details {
    border-top: 1px solid var(--v-separator);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s5) 0;
    font-weight: 600;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    color: var(--v-accent-ink);
    font-weight: 400;
    font-size: 1.4em;
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: var(--s5);
    color: var(--v-text-secondary);
  }
  @media (max-width: 860px) {
    .intro,
    .feature,
    .feature.flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro :global(.intro-phone),
    .feature :global(.feature-phone) {
      width: min(62%, 240px);
      justify-self: center;
    }
    .feature.flip :global(.feature-phone) {
      order: 0;
    }
    .intro {
      padding-block: var(--s12) 0;
    }
  }
</style>
