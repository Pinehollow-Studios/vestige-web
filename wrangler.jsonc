{
  // vestige.golf on Cloudflare Workers. The Astro adapter supplies the entry
  // point and the static-assets directory at build time.
  //
  //   npm run deploy:staging   build, then deploy the staging Worker
  //
  // Production (vestige.golf + www) is attached at the cutover, release 1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vestige-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Unknown paths get the site's own 404 page (src/pages/404.astro).
  "assets": { "not_found_handling": "404-page" },
  // vestige.golf itself. www is redirected by workers/www-redirect.
  "routes": [{ "pattern": "vestige.golf", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Per-IP limits for the Worker routes (Workers Rate Limiting, free).
  // Bindings don't inherit into env.staging, so they are repeated there.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } },
    { "name": "CLAIM_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": {
    "SITE_ENV": "production",
    "SUPABASE_URL": "https://ujbnupjrbroskzwaeulj.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVqYm51cGpyYnJvc2t6d2FldWxqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA3MTAyNzYsImV4cCI6MjA5NjI4NjI3Nn0.L85___bzXd4pHk2YwqF3Ubk8t9_DGpOIIaxYuI8mlOY"
  },
  "env": {
    "staging": {
      // next.vestige.golf, behind Cloudflare Access (the same Google gate as
      // the bunker). Never indexed: SITE_ENV is not "production".
      "name": "vestige-web-staging",
      "workers_dev": true,
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } },
        { "name": "CLAIM_LIMITER", "namespace_id": "1004", "simple": { "limit": 6, "period": 60 } }
      ],
      "vars": {
        "SITE_ENV": "staging",
        "SUPABASE_URL": "https://ujbnupjrbroskzwaeulj.supabase.co",
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVqYm51cGpyYnJvc2t6d2FldWxqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA3MTAyNzYsImV4cCI6MjA5NjI4NjI3Nn0.L85___bzXd4pHk2YwqF3Ubk8t9_DGpOIIaxYuI8mlOY"
      }
    }
  }
}
